parameters:
    paths:
        - ../src
        - ../public/index.php
    # Climbing towards max. Raise one level at a time, clearing the errors each
    # step introduces before moving up.
    level: 7
    reportUnmatchedIgnoredErrors: false
    tmpDir: ../tests/_output
    # The application registers its own namespaces via library/Core/autoload.php,
    # but that file also loads Dotenv and therefore needs a .env present. Bootstrap
    # from Composer only; the analysed paths above cover the application's classes.
    bootstrapFiles:
        - ../vendor/autoload.php
