<?xml version="1.0"?>
<ruleset name="Phalcon">
    <description>Phalcon Coding Standards</description>
    <!-- Arguments:
         p = Show progress
         s = Show sniff codes in output
         colors = Force color output (optional, often auto-detected)
    -->
    <arg name="colors"/>
    <arg value="ps"/>

    <rule ref="Phalcon">
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>
    <exclude-pattern>*/public/*</exclude-pattern>
    <exclude-pattern>*/_output/*</exclude-pattern>
    <file>../bin</file>
    <file>../src</file>
    <file>../tests</file>
</ruleset>
